# AI Trading Bot - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# MetaTrader 5 Configuration
# ============================================
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ============================================
# AI/LLM API Keys
# ============================================
# OpenAI (recommended for best results)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (alternative to OpenAI)
ANTHROPIC_API_KEY=your-anthropic-api-key

# LLM Provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# ============================================
# Data Source API Keys
# ============================================
# NewsAPI - for news aggregation
NEWS_API_KEY=your-newsapi-key

# Finnhub - for financial data and news
FINNHUB_API_KEY=your-finnhub-key

# Alpha Vantage - for forex data (optional)
ALPHA_VANTAGE_KEY=your-alpha-vantage-key

# Polygon.io - for real-time market data (optional)
POLYGON_API_KEY=your-polygon-key

# ============================================
# Trading Configuration
# ============================================
# Environment: "demo" or "live"
TRADING_ENVIRONMENT=demo

# Enable paper trading (no real trades)
PAPER_TRADING=true

# Trading symbols (comma-separated)
TRADING_SYMBOLS=XAUUSD

# ============================================
# Risk Management
# ============================================
# Maximum positions at once
MAX_POSITIONS=3

# Risk per trade (as decimal, e.g., 0.02 = 2%)
RISK_PER_TRADE=0.02

# Maximum daily loss limit (as decimal)
MAX_DAILY_LOSS=0.05

# Maximum drawdown limit
MAX_DRAWDOWN=0.15

# Minimum confidence to trade (0-1)
MIN_CONFIDENCE=0.65

# Minimum risk/reward ratio
MIN_RISK_REWARD=1.5

# ============================================
# API Server Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ============================================
# Database (Optional)
# ============================================
MONGODB_URL=mongodb://localhost:27017/ai_trading_bot
REDIS_URL=redis://localhost:6379

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=./logs

# ============================================
# Neural Network Settings
# ============================================
# Model directory for saving/loading trained models
MODEL_DIR=./models

# Enable GPU acceleration (if available)
USE_GPU=true

# ============================================
# Advanced Settings
# ============================================
# Analysis interval in seconds
ANALYSIS_INTERVAL=300

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=60

# Auto-recovery on failure
AUTO_RECOVERY=true

# Maximum recovery attempts
MAX_RECOVERY_ATTEMPTS=5
